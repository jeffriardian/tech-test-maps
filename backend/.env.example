# Backend env example
# If you want to use a real local LLM (open-webui / ollama / etc), set LLM_API_BASE to its OpenAI-compatible URL.
# For quick demo you can use the built-in mock parser by leaving USE_MOCK_LLM=1
LLM_API_BASE=http://localhost:3000
LLM_API_KEY=
LLM_MODEL=local-model
USE_MOCK_LLM=1
GOOGLE_MAPS_SERVER_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY_HERE
